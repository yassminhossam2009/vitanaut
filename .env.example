# Vitanaut environment
# Copy this file to .env and fill only the values you need.

# Server
PORT=3000
VITANAUT_DB_PATH=data/vitanaut.db

# Required in production. Use a long random string.
VITANAUT_SESSION_SECRET=change-this-to-a-long-random-secret

# Optional Assistant providers.
# The app falls back to built-in guidance when none are configured.
DR7_API_KEY=
DR7_MEDGEMMA_MODEL=medgemma-4b-it

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
